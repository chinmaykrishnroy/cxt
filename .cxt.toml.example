default_minify = true
model = "gpt-5"
max_tokens = 60000
max_output_mb = 100
scan_max_entries = 20000
scan_max_mb = 100
scan_max_depth = 32
scan_timeout = 15
secret_policy = "redact"
format = "markdown"
path_style = "relative"

include = ["src/**", "tests/**", "*.toml"]
global_ignore = ["fixtures/**", "generated/**"]

